{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../../shared/*"]
    }
  },
  "include": ["src", "../../shared/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "../../shared/**/*.test.ts"]
}
